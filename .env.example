# Тикеты Енот v2 — секреты владельца (значения вписывает ТОЛЬКО владелец, файл .env не коммитится)

# Первый администратор (создаётся при первом старте, пока таблица пользователей пуста)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Ключ подписи сессий (любая длинная случайная строка; без неё сессии слетают при рестарте)
PANEL_SECRET_KEY=

# Интеграция UseDesk (https://usedesk.ru → Настройки → API). Пусто = выключено
USEDESK_API_TOKEN=

# Телеграм-бот (создать у @BotFather) и группа (как узнать chat_id — в README). Пусто = выключено
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JSON-файл с заявками для импорта при первом старте (по желанию). Пусто = seed/tickets-2026-10-12.json
SEED_PATH=

# Файл базы SQLite. Пусто = data/tickets.sqlite
DB_PATH=

# Secure-флаг cookie сессий: 1 — только если панель опубликована за HTTPS (иначе вход сломается).
# Пусто/0 = выключено (localhost по http)
COOKIE_SECURE=

# Домен панели на хостинге (например tickets.example.ru) — для HTTPS через Caddy:
# DOMAIN=… bash scripts/install.sh сам впишет его сюда и включит COOKIE_SECURE=1.
# Пусто = панель только на 127.0.0.1:8072 (локально или за своим nginx)
DOMAIN=
